+// Styles for the Apex Sentinel AI Bots and Digits Analysis pages (dark navy + gold).
+$bg: #050a14; $panel: #0a1426; $panel-2: #0e1a31; $line: #16233d; $text: #e8eefc; $muted: #8fa1c2;
+$gold: #e8b84a; $win: #19d38a; $loss: #ff4d6a;
+
+.apex-ai, .apex-da { padding: 20px 24px 40px; color: $text; background: $bg; min-height: 100%; }
+.apex-ai .is-win, .apex-da .is-win { color: $win; }
+.apex-ai .is-loss, .apex-da .is-loss { color: $loss; }
+
+// ---------------- AI Bots ----------------
+.apex-ai {
+    &__head h1 { font-size: 26px; margin: 0 0 4px; color: #fff; }
+    &__head p { margin: 0 0 18px; color: $muted; }
+    &__grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(250px, 1fr)); gap: 16px; }
+    &__card {
+        --accent: #2a7fd1;
+        display: flex; flex-direction: column; justify-content: space-between; gap: 14px; min-height: 190px;
+        padding: 18px; border-radius: 16px; background: $panel; border: 1px solid color-mix(in srgb, var(--accent) 45%, #0b1426);
+        &.is-selected { box-shadow: 0 0 0 2px var(--accent); }
+        &--blue { --accent: #2a8cf0; } &--teal { --accent: #17c3a2; } &--purple { --accent: #8f6bff; }
+        &--orange { --accent: #ff8a2a; } &--amber { --accent: #f2b233; } &--pink { --accent: #ff4f9a; } &--red { --accent: #ff5a5a; }
+    }
+    &__card-top { display: flex; justify-content: space-between; gap: 10px; align-items: flex-start;
+        h2 { margin: 0; font-size: 20px; line-height: 1.2; color: #fff; }
+        span { color: var(--accent); font-weight: 800; } }
+    &__card p { margin: 0; color: $muted; line-height: 1.5; }
+    &__card button {
+        display: flex; justify-content: space-between; align-items: center; padding: 10px 14px; cursor: pointer;
+        border-radius: 10px; border: 1px solid var(--accent); background: color-mix(in srgb, var(--accent) 12%, transparent);
+        color: var(--accent); font-weight: 800;
+        &:disabled { opacity: .5; cursor: not-allowed; }
+    }
+    &__runner { margin-top: 22px; padding: 20px; border-radius: 16px; background: $panel; border: 1px solid $line; }
+    &__runner-head { display: flex; justify-content: space-between; align-items: center; margin-bottom: 14px;
+        small { color: $muted; letter-spacing: .12em; } h2 { margin: 2px 0 0; color: #fff; } }
+    &__badge { padding: 6px 14px; border-radius: 999px; border: 1px solid $line; font-weight: 800; color: $muted;
+        &.is-live { color: $win; border-color: $win; } }
+    &__form { display: grid; grid-template-columns: repeat(auto-fill, minmax(170px, 1fr)); gap: 12px;
+        label { display: flex; flex-direction: column; gap: 6px; font-size: 12px; color: $muted; }
+        input, select { padding: 9px 10px; border-radius: 8px; border: 1px solid $line; background: #0b1830; color: $text; font-size: 14px; } }
+    &__actions { display: flex; align-items: center; gap: 14px; margin: 16px 0; color: $muted;
+        button { padding: 10px 28px; border-radius: 10px; border: 0; font-weight: 800; cursor: pointer; }
+        .is-start { background: $gold; color: #1a1203; } .is-stop { background: $loss; color: #fff; } }
+    &__error { color: $loss; margin: 0 0 12px; }
+    &__stats { display: grid; grid-template-columns: repeat(auto-fit, minmax(130px, 1fr)); gap: 10px; margin-bottom: 14px;
+        div { padding: 10px 12px; border-radius: 10px; background: $panel-2; border: 1px solid $line; }
+        small { display: block; color: $muted; margin-bottom: 4px; } strong { font-size: 16px; color: #fff; } }
+    &__log { width: 100%; border-collapse: collapse; font-size: 13px;
+        th, td { padding: 8px 10px; text-align: left; border-bottom: 1px solid $line; }
+        th { color: $muted; font-weight: 600; } }
+    &__empty { color: $muted; text-align: center; }
+    &__note { color: $muted; font-size: 12px; margin: 14px 0 0; }
+}
+
+// ---------------- Digits Analysis ----------------
+.apex-da {
+    &__panel { padding: 22px; border-radius: 20px; background: $panel; border: 1px solid $line; }
+    &__head { display: flex; justify-content: space-between; gap: 18px; flex-wrap: wrap; align-items: flex-start;
+        h1 { margin: 0 0 6px; font-size: 30px; line-height: 1.05; color: #fff; } }
+    &__live { display: inline-flex; align-items: center; gap: 8px; color: $muted;
+        i { width: 9px; height: 9px; border-radius: 50%; background: #5f7396; &.is-on { background: $win; } } }
+    &__controls { display: flex; gap: 8px; flex-wrap: wrap; align-items: flex-end;
+        label { display: flex; flex-direction: column; gap: 4px; font-size: 11px; color: $muted; }
+        input, select { padding: 7px 9px; border-radius: 8px; border: 1px solid $line; background: #0b1830; color: $text; min-width: 90px; }
+        button { padding: 8px 14px; border-radius: 8px; border: 1px solid $line; background: $panel-2; color: $text; font-weight: 800; cursor: pointer;
+            &.is-active { border-color: $gold; color: $gold; } } }
+    &__error { color: $loss; }
+    &__body { display: grid; grid-template-columns: minmax(300px, 1fr) minmax(320px, 1fr); gap: 20px; margin-top: 18px;
+        @media (max-width: 960px) { grid-template-columns: 1fr; } }
+    &__ranking h2 { margin: 0 0 10px; font-size: 24px; color: #fff; }
+    &__ranking table { width: 100%; border-collapse: collapse; border: 1px solid $line; border-radius: 12px; overflow: hidden;
+        th { padding: 10px; text-align: left; color: $muted; font-size: 12px; letter-spacing: .08em; text-transform: uppercase; border-bottom: 1px solid $line; }
+        td { padding: 11px 10px; border-bottom: 1px solid $line; font-weight: 700; }
+        tr.is-best td { background: rgba(25, 211, 138, .08); } }
+    &__empty { color: $muted; text-align: center; padding: 14px; }
+    &__best { padding: 18px; border-radius: 18px; background: #08111f; border: 1px solid $line;
+        > small { color: $muted; letter-spacing: .12em; font-weight: 700; }
+        p { margin: 4px 0 12px; color: $muted; } }
+    &__best-title { display: flex; justify-content: space-between; align-items: baseline; gap: 10px; flex-wrap: wrap; margin-top: 6px;
+        strong { font-size: 30px; color: #fff; } span { color: $win; font-size: 24px; font-weight: 800; } }
+    &__stats { display: grid; grid-template-columns: 1fr 1fr; border: 1px solid $line; border-radius: 12px; margin-bottom: 14px;
+        > div { padding: 12px 14px; display: flex; flex-direction: column; gap: 4px; }
+        > div + div { border-left: 1px solid $line; }
+        small { color: $muted; letter-spacing: .1em; } strong { font-size: 20px; } span { color: $muted; font-size: 13px; } }
+    &__digits { display: grid; grid-template-columns: repeat(7, 1fr); gap: 8px; margin-top: 10px;
+        b { display: grid; place-items: center; height: 44px; border-radius: 8px; color: #fff; font-size: 20px;
+            &.is-win { background: #12a05f; } &.is-loss { background: #d6204a; } } }
+    &__note { margin: 16px 0 0; color: $muted; font-size: 12px; }
+}
