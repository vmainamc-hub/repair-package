+      n: psy?.n ?? 0,
+      measurability: pattern ? clamp(pattern.confidence / 100, 0, 1) : 0,
+      detail: pattern
+        ? `${pattern.side} pattern ${pattern.score}/100 vs opposite ${opposite?.score ?? 0}/100 (confidence ${pattern.confidence}/100). ${pattern.supporting[0] ?? pattern.note}`
