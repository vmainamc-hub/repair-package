+        : psychSupport === "SUPPORTING"
+          ? 2.0
+          : psychSupport === "OPPOSING"
+            ? -3.0
+            : 0;
+  if (psychPoints !== 0) {
+    factors.push({
+      label: "Digit psychology structure",
