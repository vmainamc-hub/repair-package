+      );
+    }
+
+    if (dangerTrend === "INCREASING") {
+      conflicting.push(`Market danger trajectory is INCREASING (+${dangerScore})`);
+    }
+
+    return {
+      supportingEvidence: supporting,
+      conflictingEvidence: conflicting,
+      regimeSpecificEvidence: regimeSpecific,
+    };
