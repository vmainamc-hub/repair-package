+      const dir = c.side === "OVER" ? oddGain : -oddGain;
+      w += clamp(dir * 8, -0.5, 0.5);
+      parts.push(
+        `EVEN ${(even.pressure * 100).toFixed(1)}pp vs ODD ${(odd.pressure * 100).toFixed(1)}pp`,
