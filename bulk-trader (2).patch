+  maxDangerForStrong: 35, // Strict Danger Cap (was 45)
+  maxDangerForValid: 42, // Strict Danger Cap (was 65)
+  primaryPreferenceBonus: 4, // Bounded tie-breaker window for Over 2 / Under 7
+  maxScanHistory: 10,
+  defaultStake: 2.0,
+  targetRuns: 3,
+};
