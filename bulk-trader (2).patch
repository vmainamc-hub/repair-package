+    factors.push({
+      label: "Ensemble model signal",
+      points: ensemblePoints,
+      detail: `Ensemble signal ${ensemble.signal.toFixed(2)} (${ensemble.validated} models)`,
+    });
+    total += ensemblePoints;
+  }
+
+  // 5. Simulator lifetime delta
+  const simDelta =
