+        expect(h.runner.getSnapshot().stopReason).toMatch(/unknown/i);
+        expect(h.buy.mock.calls.length).toBe(1);
+    });
+
+    it('stops on an account error', async () => {
+        h = makeHarness({ executionMode: 'immediate' });
